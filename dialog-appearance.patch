+function hexToRgba(hex: string, alpha: number): string {
+  const fallback = `rgba(0, 14, 39, ${alpha / 100})`
+  if (!hex || typeof hex !== 'string') return fallback
+  let h = hex.trim().replace('#', '')
+  if (h.length === 3) {
