{
    "name": "frontend_vue",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "pnpm run format  --log-level warn && vite",
        "lint": "pnpm run '/^lint:.*/'",
        "lint:eslint": "eslint --fix ./src",
        "lint:style": "stylelint --fix '**/*.css'",
        "lint:md": "markdownlint --fix '**/*.md' --disable MD013",
        "lint:autocorrect": "autocorrect --fix",
        "format": "pnpm run '/^format:.*/'",
        "format:prettier": "prettier --write '**/*.{js,ts,json,yaml,md,vue}'",
        "dev-full": "pnpm run lint && pnpm run dev",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@eslint/json": "^0.13.1",
        "@eslint/markdown": "^7.2.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.6.2",
        "@types/node": "^24.3.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.8.1",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-vue": "^10.4.0",
        "globals": "^16.3.0",
        "markdownlint": "^0.38.0",
        "markdownlint-cli": "^0.45.0",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "stylelint": "^16.23.1",
        "stylelint-config-standard": "^39.0.0",
        "stylelint-order": "^7.0.0",
        "tailwindcss": "^4.1.12",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.40.0",
        "vite": "^7.1.3",
        "vue": "^3.5.19",
        "vue-tsc": "^3.0.6"
    },
    "dependencies": {
        "axios": "^1.11.0",
    "vue-router": "^4.5.1"
    }
}
