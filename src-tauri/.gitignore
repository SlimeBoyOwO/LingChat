# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# 桌面端打包的运行库暂存目录（scripts/stage-desktop-runtime-libs.mjs 生成，
# 由 tauri.conf.json 的 bundle.linux.*.files 映射进安装包）。
/.runtime-libs/

# iOS：Sherpa-ONNX xcframework（scripts/setup-ios-sherpa.mjs 下载，
# tauri.ios.conf.json 的 bundle.iOS.frameworks 引用）及其版本标记。
/sherpa-onnx.xcframework/
/.sherpa-onnx-xcframework-version
