<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      系统级悬浮窗权限（「显示在其他应用上层」）。

      这是 Android 的特殊权限（special permission），特点：
      1. 无法通过运行时弹窗申请，只能跳转设置页由用户手动开启；
      2. 部分厂商 ROM（小米/华为/OPPO 等）还需额外加入「后台弹出界面」白名单；
      3. Google Play 上架需在应用说明中陈述必要性。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 悬浮窗需在 App 退到后台后继续存活，依赖前台服务 + 常驻通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
      Android 14（API 34）起，前台服务必须声明具体类型，否则启动即崩。
      桌宠「在其他应用上层持续显示一个交互角色」不属于任何既有分类
      （mediaPlayback / location / camera 等都不贴切），因此用 specialUse。

      targetSdk 36 下，specialUse 还需要下面的 PROPERTY_SPECIAL_USE_FGS_SUBTYPE
      声明具体用途；上架 Google Play 时该类型需要单独填写用途说明。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ 前台服务的常驻通知需要通知权限才可见（被拒也能启动服务，只是通知不显示） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          桌宠前台服务：把进程提升为前台优先级，避免 App 退到后台后
          进程被回收导致悬浮窗消失。详见 PetForegroundService.kt。
        -->
        <service
            android:name="com.noiq.floatingpet.PetForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="desktop_pet_overlay" />
        </service>

        <!--
          「屏幕视奸」（主动窥屏）的取景通道。详见 LingChatAccessibilityService.kt。

          三条声明缺一不可：
          · `android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"`
            —— 这是**系统绑定**该服务的凭据。没有它，系统设置里根本看不到这个服务，
            第三方 App 反而能随便绑定。这是无障碍服务的安全边界，必须写。
          · `<intent-filter>` 的 `android.accessibilityservice.AccessibilityService`
            —— 系统靠它枚举「哪些服务是可用的无障碍服务」。
          · `<meta-data>` 指向 res/xml 的配置（canTakeScreenshot 等能力声明）。

          ⚠️ `android:exported="true"` 是**必需**的：绑定的发起方是系统（另一个
          进程）。这不是「对外暴露」—— 真正的门槛是上面那条 BIND 权限。

          ⚠️ 用户必须在「设置 → 无障碍 → 已安装的服务」里手动开启，App 无法
          自行开启，也没有授权弹窗。未开启时 `isReady()` 为 false，截图直接返回
          null（调用方降级处理）。
        -->
        <service
            android:name="com.noiq.floatingpet.LingChatAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lingchat_screen_accessibility" />
        </service>
    </application>

</manifest>
