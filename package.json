{
  "name": "ling-chat",
  "private": false,
  "version": "0.5.2",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "init": "tauri icon src-tauri/icons/icon.png && node scripts/prepare-desktop-resources.mjs && node scripts/download_emotion_model.mjs && node scripts/ensure-onnxruntime.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit --skipLibCheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:prepare": "tauri android init && node scripts/generate-android-icons.mjs",
    "android:dev": "tauri android dev",
    "android:build": "node scripts/prepare-bundled-resources.mjs 9 && tauri android build --target aarch64 --apk",
    "android:check": "cargo ndk check --target aarch64-linux-android",
    "android:devbuild": "node scripts/prepare-bundled-resources.mjs 5 && tauri android build -d -t aarch64 --apk",
    "ios:init": "tauri ios init",
    "ios:build": "bash scripts/build-ios-unsigned.sh",
    "format": "prettier --write . && cargo fmt -p ling_chat -p ling-chat-main -p ling-chat-plugins",
    "format:rs": "cargo fmt -p ling_chat -p ling-chat-main -p ling-chat-plugins",
    "format:frontend": "prettier --write \"src/**/*.{vue,js,ts,css,scss}\"",
    "format:check": "prettier --check . && cargo fmt -p ling_chat -p ling-chat-main -p ling-chat-plugins -- --check",
    "check:rs": "cargo check --workspace",
    "gen:effects": "node scripts/generate-known-effects.mjs",
    "check:effects": "node scripts/generate-known-effects.mjs --check",
    "prepare": "husky"
  },
  "dependencies": {
    "7zip-min": "^3.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "axios": "^1.16.0",
    "ba-click-fx": "^1.3.3",
    "cropperjs": "^1.6.2",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.7",
    "opencc-js": "^1.4.1",
    "pinia": "^3.0.4",
    "pixi.js": "8.15.0",
    "tailwindcss": "^4.3.0",
    "tauri-plugin-screenshots-api": "file:./src-tauri/plugins/tauri-plugin-screenshots",
    "untitled-pixi-live2d-engine": "1.3.5",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.8",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.7.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-classnames": "^0.10.3",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,vue,html,css,scss,json,md}": [
      "prettier --write"
    ],
    "*.rs": [
      "rustfmt"
    ],
    "src/components/game/standard/particles/index.ts": [
      "node scripts/generate-known-effects.mjs",
      "git add crates/ling-chat-main/src/ai_service/game_system/script_engine/events/known_effects.rs"
    ]
  }
}
