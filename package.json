{
  "name": "ling-chat",
  "private": false,
  "version": "0.5.2",
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "init": "tauri icon src-tauri/icons/icon.png && node scripts/prepare-desktop-resources.mjs && node scripts/download_emotion_model.mjs && node scripts/download_embedding_model.mjs && node scripts/ensure-onnxruntime.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit --skipLibCheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:prepare": "tauri android init && node scripts/generate-android-icons.mjs",
    "android:dev": "SHERPA_ONNX_LIB_DIR=$(node scripts/package-android-sherpa-libs.mjs --print-lib-dir) && export SHERPA_ONNX_LIB_DIR && tauri android dev",
    "android:build": "SHERPA_ONNX_LIB_DIR=$(node scripts/package-android-sherpa-libs.mjs --print-lib-dir) && export SHERPA_ONNX_LIB_DIR && node scripts/prepare-bundled-resources.mjs 9 && tauri android build --target aarch64 --apk",
    "android:check": "cargo ndk check --target aarch64-linux-android",
    "android:devbuild": "SHERPA_ONNX_LIB_DIR=$(node scripts/package-android-sherpa-libs.mjs --print-lib-dir) && export SHERPA_ONNX_LIB_DIR && node scripts/prepare-bundled-resources.mjs 5 && tauri android build -d -t aarch64 --apk",
    "ios:init": "tauri ios init",
    "ios:build": "bash scripts/build-ios-unsigned.sh",
    "format": "prettier --write . && cargo fmt -p ling_chat -p ling-chat-main -p ling-chat-plugins",
    "format:rs": "cargo fmt -p ling_chat -p ling-chat-main -p ling-chat-plugins",
    "format:frontend": "prettier --write \"src/**/*.{vue,js,ts,css,scss}\"",
    "format:check": "prettier --check . && cargo fmt -p ling_chat -p ling-chat-main -p ling-chat-plugins -- --check",
    "check:rs": "cargo check --workspace",
    "gen:effects": "node scripts/generate-known-effects.mjs",
    "check:effects": "node scripts/generate-known-effects.mjs --check",
    "prepare": "husky"
  },
  "dependencies": {
    "7zip-min": "^3.0.1",
    "@lucide/vue": "^1.70.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "axios": "^1.21.0",
    "ba-click-fx": "^1.3.15",
    "cropperjs": "^1.7.0",
    "marked": "^18.1.3",
    "opencc-js": "^1.4.2",
    "pinia": "^3.0.4",
    "pixi.js": "8.15.0",
    "tailwindcss": "^4.3.5",
    "tauri-plugin-screenshots-api": "file:./src-tauri/plugins/tauri-plugin-screenshots",
    "untitled-pixi-live2d-engine": "1.3.5",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-classnames": "^0.10.5",
    "prettier-plugin-merge": "^0.10.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript": "~5.6.3",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^2.2.12"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,vue,html,css,scss,json,md}": [
      "prettier --write"
    ],
    "*.rs": [
      "rustfmt"
    ],
    "src/components/game/standard/particles/index.ts": [
      "node scripts/generate-known-effects.mjs",
      "git add crates/ling-chat-main/src/ai_service/game_system/script_engine/events/known_effects.rs"
    ]
  }
}
